# 网易云音乐 Telegram Bot - 本地部署版配置
# 复制此文件为 .env 并填写配置
# 注意：本地部署版必须使用 Webhook 模式，必须配置 WEBHOOK_URL

# ==================== 必须配置 ====================

# Upstash Redis 配置（从 upstash.com 获取）
# 其他配置（BOT_TOKEN、ADMIN_ID、NETEASE_COOKIE）从 Upstash 数据库读取
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=你的Upstash Token

# CF 隧道地址（必须配置，本地部署版强制使用 Webhook 模式）
# 运行 start_cf_tunnel.bat 后获取，格式如 https://xxx.trycloudflare.com
WEBHOOK_URL=https://xxx.trycloudflare.com

# ==================== 可选配置（也可从 Upstash 读取） ====================

# Telegram Bot Token（从 @BotFather 获取，也可存储在 Upstash）
BOT_TOKEN=

# 管理员 Telegram 数字 ID（从 @userinfobot 获取，也可存储在 Upstash）
ADMIN_ID=

# 网易云 MUSIC_U Cookie（也可存储在 Upstash，通过 /setcookie 设置）
NETEASE_COOKIE=

# 音质等级: standard / higher / exhigh / lossless / hires
MUSIC_QUALITY=standard

# 本地服务端口
PORT=8080

# 本地音频代理 URL（留空则使用 WEBHOOK_URL）
LOCAL_AUDIO_PROXY=

